# --- BASE DE DATOS (POSTGRES) ---
DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=rio_db

# --- BASE DE DATOS DE TESTS ---
DB_TEST_USER=user
DB_TEST_PASSWORD=password
DB_TEST_NAME=rio_db_test

# --- CONFIGURACIÓN DE LA API (FASTAPI) ---
API_PORT=8000
API_RELOAD=true
RATE_LIMIT_DEFAULT=60/minute

# --- DASHBOARD (nginx) ---
DASHBOARD_PORT=3000

# --- CONFIGURACIÓN GLOBAL DEL SCRAPER ---
SCRAPER_TICK=60
ALLOWED_RIVERS=URUGUAY

# --- PREFECTURA NAVAL ARGENTINA ---
PREFECTURA_INTERVAL=43200
BASE_SOURCE_URL=https://contenidosweb.prefecturanaval.gob.ar/alturas/

# --- 6. FUENTE: INA (Instituto Nacional del Agua) ---
INA_ENABLED=true
INA_INTERVAL=3600
INA_API_BASE_URL=https://alerta.ina.gob.ar/a5
INA_VAR_ID=2
INA_INCREMENTAL_HOURS=48
INA_BACKFILL_DAYS=7

# --- 7. FUENTE: CARU (Comisión Administradora del Río Uruguay) ---
CARU_ENABLED=true
CARU_INTERVAL=1800
CARU_BASE_URL=http://190.0.152.194:8080/alturas/web/user
CARU_INCREMENTAL_HOURS=24